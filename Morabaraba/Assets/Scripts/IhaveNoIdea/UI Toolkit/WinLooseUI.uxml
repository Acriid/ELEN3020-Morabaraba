<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd">

    <ui:VisualElement style="
        flex-grow: 1;
        justify-content: center;
        align-items: center;
        background-color: rgb(30, 30, 47);
    ">

        <ui:Label
            name="ResultLabel"
            text="You Win/Lose"
            style="
                font-size: 80px;
                unity-text-align: middle-center;
                color: rgb(213, 213, 213);
                -unity-font-style: bold;
                margin-bottom: 40px;
            " />

        <ui:Button
            name="ExitButton"
            text="Back to Menu"
            style="
                width: 300px;
                height: 80px;
                font-size: 30px;
                background-color: rgb(170, 34, 34);
                color: white;
            " />

    </ui:VisualElement>

</ui:UXML>