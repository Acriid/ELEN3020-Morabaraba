<ui:UXML 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">

    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=6698bb73e43d7de439d2393b2090d26b&amp;type=3#MainMenuStyle"/>

    <ui:VisualElement class="container">

        <ui:VisualElement class="menu-panel" style="background-color: rgb(65, 65, 109);">

            <ui:Label 
                text="Game Setup" 
                class="title"
                style="font-size: 42px;" />

            <ui:Label 
                text="Select Mode"
                class="section-title"
                style="font-size: 24px;" />

            <ui:DropdownField
                name="gameModeDropdown"
                label="Mode"
                choices="Player vs Player,Player vs AI"
                index="0"
                style="width: 320px; height: 45px; font-size: 18px;" />

            <ui:Label 
                text="Select Board"
                class="section-title"
                style="font-size: 24px; margin-top: 15px;" />

            <ui:DropdownField
                name="boardTypeDropdown"
                label="Board Type"
                choices="Morabaraba,Nine Men's Morris,Six Men's Morris"
                index="0"
                style="width: 320px; height: 45px; font-size: 18px;" />

            <ui:VisualElement 
                name="aiDifficultyContainer"
                style="width: 100%; align-items: center; margin-top: 15px;">

                <ui:Label 
                    text="AI Difficulty"
                    class="section-title"
                    style="font-size: 24px;" />

                <ui:DropdownField
                    name="aiDifficultyDropdown"
                    label="Difficulty"
                    choices="Easy,Medium,Hard"
                    index="0"
                    style="width: 320px; height: 45px; font-size: 18px;" />
            </ui:VisualElement>

            <ui:Button 
                name="startButton"
                text="Start Game"
                class="host-button"
                style="font-size: 22px; margin-top: 25px;" />

            <ui:Button 
                name="backButton"
                text="Back"
                class="join-button"
                style="font-size: 18px;" />

            <!-- FEEDBACK -->
            <ui:Label 
                text=""
                name="feedbackLabel"
                style="font-size: 18px; color: rgb(0,255,9); height: 24px; margin-top: 10px;" />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>